# Writes a CTest file with one test per test case of the executable
# (called after each build of run_tests)
execute_process(COMMAND ${TEST_EXE} --list OUTPUT_VARIABLE names RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "Could not list the tests of ${TEST_EXE}")
endif()
string(REPLACE "\n" ";" names "${names}")
set(content "")
foreach(name IN LISTS names)
  if(name STREQUAL "")
    continue()
  endif()
  string(APPEND content "add_test([=[${name}]=] \"${TEST_EXE}\" --exact [=[${name}]=])\n")
  string(APPEND content "set_tests_properties([=[${name}]=] PROPERTIES FIXTURES_REQUIRED lcd_output ENVIRONMENT \"LCD_TEST_OUTPUT=${OUTPUT_DIR}\")\n")
endforeach()
file(WRITE ${OUT} "${content}")
